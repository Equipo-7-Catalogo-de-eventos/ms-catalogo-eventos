    {
      "name": "I1 - Panel Organizador hacia Catálogo",
      "description": "Servicio consumido por Catálogo: GET /api/v1/organizador/eventos/proximos (Panel Organizador). Contrato: CONTRATO_CATALOGO_PANEL.md. Issue #10.",
      "item": [
        {
          "name": "I1.1 Panel entrega los eventos publicados (contraparte)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Entrega una lista de eventos\", () => pm.expect(json).to.be.an(\"array\"));",
                  "pm.test(\"Cada evento trae id_evento y nombre_evento\", () => {",
                  "  json.forEach(e => { pm.expect(e).to.have.property(\"id_evento\"); pm.expect(e).to.have.property(\"nombre_evento\"); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/organizador/v1/organizador/eventos/proximos?limite=6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "organizador",
                "v1",
                "organizador",
                "eventos",
                "proximos"
              ],
              "query": [
                {
                  "key": "limite",
                  "value": "6"
                }
              ]
            },
            "description": "Consulta directa a Panel Organizador por el API Gateway, con la misma ruta que consume Catálogo."
          }
        },
        {
          "name": "I1.2 Catálogo lista los eventos recibidos desde Panel (éxito)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"success es true\", () => pm.expect(json.success).to.eql(true));",
                  "pm.test(\"Entrega al menos un evento\", () => pm.expect(json.data).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Cada evento trae los campos del contrato\", () => {",
                  "  json.data.forEach(e => {",
                  "    pm.expect(e).to.include.keys(\"id_evento\", \"nombre_evento\", \"fecha_evento\", \"precio_final_evento\", \"stock_actual\", \"es_pasado\");",
                  "  });",
                  "});",
                  "pm.test(\"La cantidad de eventos no supera el límite\", () => pm.expect(json.count).to.be.at.most(json.pagination.limite));",
                  "// Guarda un evento real para los casos siguientes",
                  "const e = json.data[0];",
                  "pm.collectionVariables.set(\"evento_id\", e.id_evento);",
                  "pm.collectionVariables.set(\"evento_precio\", e.precio_final_evento);",
                  "pm.collectionVariables.set(\"evento_nombre\", e.nombre_evento);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalogo/eventos?limite=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalogo",
                "eventos"
              ],
              "query": [
                {
                  "key": "limite",
                  "value": "50"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "I1.3 Panel responde 404 ante un evento inexistente (error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.expect(pm.response.code).to.eql(404));"
                ]
              }
