                "{{panel_id_inexistente}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "I1.4 Catálogo rechaza una fecha inválida con 400 (error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"success es false\", () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalogo/eventos?fecha_desde=no-es-fecha",
