    {
      "name": "I2 - Entradas/Inventario hacia Catálogo (stock)",
      "description": "Servicio proporcionado por Catálogo: PUT /api/catalogo/eventos/{id}/stock, invocado por Entradas. Contrato: CONTRATO_ENTRADAS_CATALOGO.md. Issue #12. El caso exitoso reenvía el stock actual del evento para no alterar los datos.",
      "item": [
        {
          "name": "I2.1 Obtener el stock actual del evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"El detalle trae stock_actual\", () => pm.expect(d.stock_actual).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"stock_actual\", d.stock_actual);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalogo/eventos/{{evento_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalogo",
                "eventos",
                "{{evento_id}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "I2.2 Actualizar stock con un valor válido (éxito)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"success es true\", () => pm.expect(json.success).to.eql(true));",
                  "pm.test(\"El stock guardado es el enviado\", () => pm.expect(json.data.stock_actual).to.eql(Number(pm.collectionVariables.get(\"stock_actual\"))));",
                  "pm.test(\"El estado es coherente con el stock\", () => {",
                  "  if (json.data.stock_actual === 0) pm.expect(json.data.estado_evento).to.eql(\"agotado\");",
                  "  else pm.expect(json.data.estado_evento).to.not.eql(\"agotado\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalogo/eventos/{{evento_id}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalogo",
                "eventos",
                "{{evento_id}}",
                "stock"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nuevo_stock\": {{stock_actual}},\n  \"token_sesion\": \"token-prueba-postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
